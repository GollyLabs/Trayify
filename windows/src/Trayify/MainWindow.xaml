<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Trayify.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Trayify.UI"
    Title="Trayify">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (content extends into it; Mica shows through) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/Trayify.png" Width="18" Height="18" />
                <TextBlock Text="Trayify" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,4,28,28" Spacing="6" MaxWidth="980" HorizontalAlignment="Stretch">
                <TextBlock Text="Trayify" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Send windows to the notification area instead of closing or minimizing them."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,4" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE921;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Right-click minimize sends to tray" />
                            <TextBlock Text="Right-click the minimize button of any window to hide it in the tray." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RightClickSwitch" AutomationProperties.Name="Right-click minimize sends to tray" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnRightClickToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE92E;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Alt+F4 also sends close-to-tray apps to the tray" />
                            <TextBlock Text="Applies only to the apps listed under Close-to-tray apps." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AltF4Switch" AutomationProperties.Name="Alt+F4 sends close-to-tray apps to the tray" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnAltF4Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B0;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Detect app-drawn title bar buttons" />
                            <TextBlock Text="Uses UI Automation for apps whose buttons don't report as caption buttons (e.g. Discord). Chromium-based apps may turn on accessibility support while you hover their title bar." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="UiaSwitch" AutomationProperties.Name="Detect app-drawn title bar buttons" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnUiaToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock x:Name="StartupDetails" Text="Starts Trayify elevated in the tray when you sign in (Task Scheduler logon task, no UAC prompt)." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch" AutomationProperties.Name="Start with Windows" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnStartupToggled" />
                    </Grid>
                </Border>

                <!-- Rules -->
                <TextBlock Text="Close-to-tray apps" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,18,0,4" />
                <TextBlock x:Name="NoRulesText" Text="No apps yet. Turn on “Close to tray” for an app under Open windows below; its X button will then hide it to the tray."
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:RuleItem">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Icon}" Width="24" Height="24" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Message, Mode=OneWay}" Visibility="{x:Bind MessageVisibility, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- Shortcut recorder: click, press a combination; Esc cancels, Backspace clears -->
                                    <Button Grid.Column="2" MinWidth="120" Tag="{x:Bind Exe}" VerticalAlignment="Center"
                                            Click="OnRecordHotkey" KeyDown="OnRecorderKeyDown" LostFocus="OnRecorderLostFocus"
                                            AutomationProperties.Name="{x:Bind ShortcutLabel}"
                                            ToolTipService.ToolTip="Global shortcut: hides this app to the tray, or restores it">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE765;" FontSize="14" />
                                            <TextBlock Text="{x:Bind ShortcutButtonText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Tag="{x:Bind Exe}" Click="OnClearHotkey" VerticalAlignment="Center" Visibility="{x:Bind ClearVisibility, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind ClearShortcutLabel}" ToolTipService.ToolTip="Clear shortcut">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="4" Content="Remove" Tag="{x:Bind Exe}" AutomationProperties.Name="{x:Bind RemoveLabel}" Click="OnRemoveRule" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Hidden windows -->
                <Grid Margin="0,18,0,4">
                    <TextBlock x:Name="HiddenHeader" Text="In the tray" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RestoreAllButton" Content="Restore all" HorizontalAlignment="Right" Click="OnRestoreAll" />
                </Grid>
                <TextBlock x:Name="NoHiddenText" Text="Nothing is hidden right now." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="HiddenList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:HiddenItem">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Icon}" Width="24" Height="24" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Restore" AutomationProperties.Name="{x:Bind RestoreLabel}" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Id}" Click="OnRestoreOne" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Open windows -->
                <Grid Margin="0,18,0,4">
                    <TextBlock Text="Open windows" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Click="OnRefresh" ToolTipService.ToolTip="Refresh">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl x:Name="WindowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:OpenWindowItem">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Icon}" Width="24" Height="24" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Tag="{x:Bind Id}" Click="OnSendToTray" AutomationProperties.Name="{x:Bind SendLabel}" VerticalAlignment="Center" ToolTipService.ToolTip="Send this window to the tray now">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    </Button>
                                    <ToggleSwitch Grid.Column="3" MinWidth="0" OnContent="Close to tray" OffContent="Close to tray"
                                                  IsOn="{x:Bind IsRule, Mode=OneWay}" AutomationProperties.Name="{x:Bind RuleLabel}" Toggled="OnRuleToggled" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="Close this app to the tray: its X button hides it instead of closing" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
